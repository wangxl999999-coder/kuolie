.post-card {
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-info {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  overflow: hidden;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-default {
  width: 72rpx;
  height: 72rpx;
}

.author-detail {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-meta {
  display: flex;
  align-items: center;
}

.category-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  color: #fff;
}

.tag-1 {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
}

.tag-2 {
  background: linear-gradient(135deg, #4ECDC4, #6EE7DE);
}

.tag-3 {
  background: linear-gradient(135deg, #45B7D1, #65C9E1);
}

.tag-4 {
  background: linear-gradient(135deg, #9B59B6, #BB79D6);
}

.top-tag {
  font-size: 20rpx;
  background: #FF4757;
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
}

.city-tag {
  font-size: 22rpx;
  color: #999;
  margin-left: 10rpx;
}

.post-content {
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.post-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.qr-code-mask {
  background: linear-gradient(135deg, #f8f9fa, #e9ecef);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-mask-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-lock-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.qr-lock-text {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.qr-lock-hint {
  font-size: 22rpx;
  color: #FF6B6B;
  margin-top: 8rpx;
}

.qr-unlocked {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-code-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 8rpx;
}

.qr-code-tip {
  font-size: 22rpx;
  color: #999;
}

.post-footer {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.post-action {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #999;
}
