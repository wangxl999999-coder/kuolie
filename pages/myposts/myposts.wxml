<view class="page">
  <view class="post-list" wx:if="{{posts.length > 0}}">
    <view class="post-card card" wx:for="{{posts}}" wx:key="id" bindtap="onPostTap" data-id="{{item.id}}">
      <view class="post-header">
        <text class="category-tag tag-{{item.category}}">{{item.categoryName}}</text>
        <text class="top-tag" wx:if="{{item.isTop}}">置顶</text>
        <text class="post-time">{{item.timeAgo}}</text>
      </view>
      <view class="post-content">
        <text class="content-text">{{item.content}}</text>
      </view>
      <view class="post-images" wx:if="{{item.images.length > 0}}">
        <image class="post-image" wx:for="{{item.images}}" wx:for-item="img" wx:key="index" src="{{img}}" mode="aspectFill"></image>
      </view>
      <view class="post-footer">
        <text class="footer-item">{{item.likeCount}} 赞</text>
        <text class="footer-item">{{item.commentCount}} 评论</text>
        <text class="footer-delete" catchtap="onDeletePost" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{posts.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无帖子，快去发布吧</text>
  </view>
</view>
