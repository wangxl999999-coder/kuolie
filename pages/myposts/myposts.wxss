.page {
  background: #F5F5F5;
  min-height: 100vh;
  padding: 20rpx 24rpx;
}

.post-card {
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.category-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  color: #fff;
  margin-right: 12rpx;
}

.tag-1 {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
}

.tag-2 {
  background: linear-gradient(135deg, #4ECDC4, #6EE7DE);
}

.tag-3 {
  background: linear-gradient(135deg, #45B7D1, #65C9E1);
}

.tag-4 {
  background: linear-gradient(135deg, #9B59B6, #BB79D6);
}

.top-tag {
  font-size: 20rpx;
  background: #FF4757;
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-content {
  margin-bottom: 12rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.footer-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 30rpx;
}

.footer-delete {
  font-size: 24rpx;
  color: #FF4757;
  margin-left: auto;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
