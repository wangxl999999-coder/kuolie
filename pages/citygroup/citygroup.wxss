.page {
  background: #F5F5F5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.search-section {
  padding: 16rpx 24rpx;
  background: #fff;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.points-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 20rpx 24rpx;
}

.points-label {
  font-size: 26rpx;
  color: #666;
}

.points-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B6B;
  margin: 0 16rpx;
}

.points-hint {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.group-list {
  padding: 0 24rpx;
}

.group-card {
  margin-bottom: 20rpx;
}

.group-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.group-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #4ECDC4, #6EE7DE);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.group-avatar-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.group-basic {
  flex: 1;
}

.group-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.group-city {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.group-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.group-tags {
  display: flex;
  margin-bottom: 16rpx;
}

.group-tag {
  background: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
}

.group-footer {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.group-qrcode-area {
  display: flex;
  align-items: center;
  justify-content: center;
}

.qrcode-locked {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.lock-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.lock-text {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.lock-cost {
  font-size: 22rpx;
  color: #999;
  margin-left: 16rpx;
}

.qrcode-unlocked {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 8rpx;
}

.qr-tip {
  font-size: 22rpx;
  color: #999;
}
