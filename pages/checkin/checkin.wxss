.page {
  background: #F5F5F5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.checkin-card {
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.checkin-bg {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 20rpx;
}

.checkin-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.checkin-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 40rpx;
}

.checkin-status {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.checked-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  color: #fff;
  font-size: 32rpx;
  margin-right: 12rpx;
}

.checked-text {
  font-size: 30rpx;
  color: #fff;
}

.btn-checkin {
  background: #fff;
  color: #FF6B6B;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  padding: 20rpx 100rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-checkin::after {
  border: none;
}

.btn-checked {
  background: rgba(255, 255, 255, 0.4);
  color: #fff;
}

.checkin-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.points-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 24rpx;
}

.points-row {
  display: flex;
  align-items: baseline;
}

.points-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.points-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.points-history-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
}

.task-section {
  padding: 0 24rpx;
  margin-top: 20rpx;
}

.task-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.task-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.task-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.task-icon-video {
  background: linear-gradient(135deg, #4ECDC4, #6EE7DE);
}

.task-icon-invite {
  background: linear-gradient(135deg, #45B7D1, #65C9E1);
}

.task-icon-text {
  font-size: 36rpx;
  color: #fff;
}

.task-info {
  display: flex;
  flex-direction: column;
}

.task-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.task-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.task-right {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.task-reward {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.btn-task {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  border: none;
  line-height: 1.6;
}

.btn-task::after {
  border: none;
}

.btn-task[disabled] {
  background: #ddd;
  color: #fff;
}

.calendar-section {
  margin: 20rpx 24rpx;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.calendar-day {
  width: calc(100% / 7);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.day-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #eee;
  margin-bottom: 6rpx;
}

.day-dot-active {
  background: #FF6B6B;
}

.day-num {
  font-size: 22rpx;
  color: #999;
}
