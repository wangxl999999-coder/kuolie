.page {
  padding: 20rpx;
  background: #F5F5F5;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
}

.category-option {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.category-option-active {
  background: rgba(255, 107, 107, 0.1);
  border-color: #FF6B6B;
}

.category-option-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.category-option-name {
  font-size: 26rpx;
  color: #666;
}

.category-option-active .category-option-name {
  color: #FF6B6B;
  font-weight: bold;
}

.category-hint {
  font-size: 24rpx;
  color: #FF6B6B;
}

.content-input {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #FAFAFA;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #ccc;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.top-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-info {
  flex: 1;
}

.top-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.top-switch {
  transform: scale(0.8);
}

.top-cost {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cost-text {
  font-size: 24rpx;
  color: #666;
}

.cost-warn {
  font-size: 24rpx;
  color: #FF4757;
  margin-left: 20rpx;
}

.publish-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-publish {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-publish[disabled] {
  background: #ddd;
  color: #fff;
}

.btn-publish::after {
  border: none;
}
