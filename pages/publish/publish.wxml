<view class="page">
  <!-- 分类选择 -->
  <view class="section card">
    <text class="section-label">选择分类</text>
    <view class="category-list">
      <view class="category-option {{selectedCategory === item.id ? 'category-option-active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="onCategorySelect" data-id="{{item.id}}">
        <text class="category-option-icon">{{item.icon}}</text>
        <text class="category-option-name">{{item.name}}</text>
      </view>
    </view>
    <text class="category-hint" wx:if="{{!selectedCategory}}">请选择一个分类</text>
  </view>

  <!-- 内容输入 -->
  <view class="section card">
    <text class="section-label">帖子内容</text>
    <textarea class="content-input" placeholder="分享你的想法..." maxlength="500" value="{{content}}" bindinput="onContentInput" />
    <view class="char-count">
      <text>{{content.length}}/500</text>
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="section card">
    <text class="section-label">添加图片</text>
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="index">
        <image class="preview-image" src="{{item}}" mode="aspectFill" bindtap="onImagePreview" data-index="{{index}}"></image>
        <view class="image-delete" catchtap="onImageDelete" data-index="{{index}}">
          <text>✕</text>
        </view>
      </view>
      <view class="image-add" bindtap="onImageAdd" wx:if="{{images.length < 9}}">
        <text class="add-icon">+</text>
        <text class="add-text">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <!-- 置顶选项 -->
  <view class="section card">
    <view class="top-option" bindtap="onTopToggle">
      <view class="top-info">
        <text class="section-label" style="margin-bottom:0">帖子置顶</text>
        <text class="top-desc">置顶帖子将显示在列表最前面，消耗200积分</text>
      </view>
      <switch class="top-switch" checked="{{isTop}}" bindchange="onTopToggle" color="#FF6B6B" />
    </view>
    <view class="top-cost" wx:if="{{isTop}}">
      <text class="cost-text">当前积分: {{points}} | 置顶消耗: 200积分</text>
      <text class="cost-warn" wx:if="{{points < 200}}">积分不足，无法置顶</text>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="publish-wrap">
    <button class="btn-publish" bindtap="onPublish" disabled="{{!canPublish}}">发布帖子</button>
  </view>
</view>
