.page {
  padding-bottom: 20rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: #999;
  font-size: 26rpx;
}

.points-wrap {
  margin-left: 20rpx;
}

.points-text {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.banner-section {
  padding: 16rpx 24rpx;
}

.banner-swiper {
  height: 260rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.banner-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.category-section {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.category-scroll {
  display: flex;
  padding: 0 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  padding: 12rpx 0;
}

.category-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

.category-active .category-name {
  color: #FF6B6B;
  font-weight: bold;
}

.category-active {
  position: relative;
}

.category-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  background: #FF6B6B;
  border-radius: 3rpx;
}

.post-list {
  padding: 0 24rpx;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

.search-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  z-index: 999;
}

.search-modal-content {
  padding-top: 20rpx;
}

.search-modal-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.search-input-focus-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
}

.search-input-real {
  flex: 1;
  font-size: 28rpx;
  margin-left: 12rpx;
}

.search-cancel {
  margin-left: 20rpx;
  color: #FF6B6B;
  font-size: 28rpx;
}

.search-results {
  padding: 0 24rpx;
}

.search-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}

.search-hot {
  padding: 30rpx 24rpx;
}

.search-hot-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.search-hot-tags {
  display: flex;
  flex-wrap: wrap;
}

.hot-tag {
  background: #F5F5F5;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}
